# Sparkle configuration — committed, single source of truth for public key + feed URL.
# Consumed by Scripts/package_app.sh (writes Info.plist) and Scripts/upload_r2.ts (knows public URLs).
#
# One-time setup:
#   1. brew install --cask sparkle
#   2. generate_keys           # prints the public key; private lands in default "ed25519" slot
#   3. Rename the keychain account to "ed25519-shun" so other Sparkle-signed apps
#      (e.g. Sokki uses "ed25519-sokki") can coexist under the same service
#   4. Paste the public key below as SPARKLE_PUBLIC_KEY
#   5. Fill SPARKLE_FEED_URL / SPARKLE_PUBLIC_BASE_URL
#      (custom domain served by ../downloads-worker; r2.dev stays enabled as fallback)
#   6. Back up the private key to a password manager

SPARKLE_PUBLIC_KEY=ppa8pUP+qUI774XKMiUmWgwFJh7wYHsQ8R1qd0NKvEI=
SPARKLE_FEED_URL=https://download.sorrycc.dev/shun/appcast.xml
SPARKLE_PUBLIC_BASE_URL=https://download.sorrycc.dev
