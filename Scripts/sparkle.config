# Sparkle configuration — committed, single source of truth for public key + feed URL.
# Consumed by Scripts/package_app.sh (writes Info.plist) and Scripts/upload_r2.ts (knows public URLs).
#
# One-time setup:
#   1. brew install --cask sparkle
#   2. generate_keys           # prints the public key; private stays in login keychain
#   3. Paste the public key below as SPARKLE_PUBLIC_KEY
#   4. Fill SPARKLE_FEED_URL / SPARKLE_PUBLIC_BASE_URL with your r2.dev URL

SPARKLE_PUBLIC_KEY=ppa8pUP+qUI774XKMiUmWgwFJh7wYHsQ8R1qd0NKvEI=
SPARKLE_FEED_URL=https://pub-35387f8a923241ffa2dc24251ae7b9d0.r2.dev/shun/appcast.xml
SPARKLE_PUBLIC_BASE_URL=https://pub-35387f8a923241ffa2dc24251ae7b9d0.r2.dev
